# files typo3 creates when installed
/config
/public
/var
/vendor
/typo3temp

# entry point created by TYPO3 testing framework bootstrap
/index.php

# a lock file does not make sense for a library
/composer.lock

# Bundled libraries: committed on purpose, so that a plain download of this
# repository can be dropped into typo3conf/ext/mcp_server of a classic-mode
# (non-composer) TYPO3 installation without running composer first.
# Regenerate with: cd Resources/Private/PHP && composer install --no-dev \
#   --optimize-autoloader --classmap-authoritative

# TER build artifacts
/dist
/.build
/.Build

# TYPO3 temp and test artifacts
/typo3temp
/index.php

# Node / Playwright
/Build/node_modules
/Build/playwright-report
/Build/test-results
/Build/tests/playwright/.auth/login.json

# other
*.local
.DS_Store
.idea
